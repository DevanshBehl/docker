FROM oven/bun:1
WORKDIR /usr/src/app

# Install deps first so this layer is cached until a manifest changes
COPY package.json bun.lock turbo.json ./
COPY packages ./packages
COPY apps/web/package.json ./apps/web/package.json
RUN bun install

COPY apps/web ./apps/web
# Builds @repo/db (prisma generate + tsc) and then web. No database needed.
RUN DATABASE_URL=postgresql://build:build@localhost:5432/build bunx turbo run build --filter=web

ENV NODE_ENV=production
EXPOSE 3000

# DATABASE_URL is supplied at runtime; apply pending migrations, then start
CMD ["sh", "-c", "cd packages/db && bunx prisma migrate deploy && cd ../.. && bun run start:web"]
